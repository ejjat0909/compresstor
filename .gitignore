# Built release artifacts (regenerate via scripts/build_*.sh|bat)
# The .app is large (262M) and NOT committed — the .dmg installer is the
# tracked, distributable artifact (build_macos.sh + build_dmg.sh rebuild both).
/release/MacOS/Compresstor.app/
/release/Windows/Compresstor/

# Auto-update artifacts (regenerate per build; the .zip is ~50M)
/release/Compresstor-*.zip
/release/Compresstor-*.sha256

